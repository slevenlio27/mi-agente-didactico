# Solo para desarrollo (npm run dev). En producción el backend sirve el frontend
# y las llamadas van a la misma dirección.
VITE_API_URL=http://localhost:8000

# Opcional: el Client ID de Google ahora lo entrega el backend (GOOGLE_CLIENT_ID
# en backend/.env). Esta variable solo se usa como respaldo.
VITE_GOOGLE_CLIENT_ID=
