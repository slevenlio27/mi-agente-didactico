# Déjalo vacío: lo genera automáticamente  python scripts/generate_secrets.py
# (los scripts de instalación y dev.sh / dev.ps1 lo ejecutan por ti).
# El servidor se niega a arrancar si está vacío o tiene un valor de ejemplo.
SECRET_KEY=

# Cifra las claves de API que cada docente guarda en Preferencias de IA.
# También lo genera scripts/generate_secrets.py. ¡No lo pierdas! Sin esta llave,
# las claves guardadas no se pueden descifrar y cada docente tendría que volver a pegarla.
API_KEYS_ENCRYPTION_KEY=

DATABASE_URL=sqlite:///./app.db
# Supabase (PostgreSQL): pega la cadena "Session pooler" de tu proyecto, cambiando
# [YOUR-PASSWORD] por la contraseña de la base de datos (ver INSTALL_SUPABASE.md):
# DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres

# Supabase Storage para los archivos (opcional; vacío = disco local).
# Usa la clave secreta (sb_secret_…) de Settings > API Keys. Da acceso total:
# NUNCA la pongas en frontend/.env ni la subas a GitHub.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=uploads
# Para MySQL con Docker, no escribas la URL a mano: corre
#   python scripts/generate_secrets.py --mysql
# y se genera una contraseña aleatoria y esta línea se actualiza sola.

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# En local con http, deja COOKIE_SECURE=false.
# En producción con HTTPS, ponlo en true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

FRONTEND_ORIGIN=http://localhost:5173

# Correos que se vuelven administradores automáticamente al registrarse o
# iniciar sesión (separados por coma). Necesario para ver el panel de admin.
ADMIN_EMAILS=

# Necesario solo si activas "Iniciar sesión con Google". Créalo en
# https://console.cloud.google.com/apis/credentials (tipo "ID de cliente de OAuth",
# aplicación web) y agrega http://localhost:5173 como origen autorizado.
GOOGLE_CLIENT_ID=

# Rellena al menos una de estas para poder usar ese proveedor de IA
OPENAI_API_KEY=
GEMINI_API_KEY=
# Modelo de Gemini. Si Google lo retira, cámbialo por uno vigente de
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash
# Segundos de espera a Gemini (los PDF largos pueden tardar más de un minuto)
GEMINI_TIMEOUT=120
ANTHROPIC_API_KEY=
